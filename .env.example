# ============ Database Configuration ============
DB_NAME=onlineshop_db
DB_USER=onlineshop_user
DB_PASSWORD=ChangeMeSecurePassword123!
DB_ROOT_PASSWORD=ChangeMeRootPassword456!
DB_PORT=3306

# ============ Spring Profile ============
# Options: dev, prod
SPRING_PROFILES_ACTIVE=prod

# ============ OAuth2 Google (Optional) ============
# Leave empty if not using Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============ Admin User (Created on first startup) ============
ADMIN_EMAIL=admin@onlineshop.de
ADMIN_PASSWORD=AdminSecure2026!

# ============ Upload Directory ============
# For Docker: /app/uploads
# For local dev: ./dev-uploads
APP_UPLOAD_DIR=/app/uploads
